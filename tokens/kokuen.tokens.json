{
  "$description": "KOKUEN starter token schema. Replace values per product; preserve semantic role names unless the product has a documented reason to differ.",
  "color": {
    "neutral": {
      "0": { "$type": "color", "$value": "#ffffff" },
      "50": { "$type": "color", "$value": "#f7f7f5" },
      "400": { "$type": "color", "$value": "#76766f" },
      "700": { "$type": "color", "$value": "#3d3d38" },
      "950": { "$type": "color", "$value": "#171717" }
    },
    "focus": { "$type": "color", "$value": "#315c9a" },
    "error": { "$type": "color", "$value": "#9d2f24" },
    "success": { "$type": "color", "$value": "#2d6b45" },
    "canvas": { "$type": "color", "$value": "{color.neutral.50}" },
    "surface": { "$type": "color", "$value": "{color.neutral.0}" },
    "text": {
      "primary": { "$type": "color", "$value": "{color.neutral.950}" },
      "muted": { "$type": "color", "$value": "{color.neutral.700}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.neutral.400}" },
      "strong": { "$type": "color", "$value": "{color.neutral.700}" }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "4": { "$type": "dimension", "$value": "4px" },
    "8": { "$type": "dimension", "$value": "8px" },
    "12": { "$type": "dimension", "$value": "12px" },
    "16": { "$type": "dimension", "$value": "16px" },
    "24": { "$type": "dimension", "$value": "24px" },
    "32": { "$type": "dimension", "$value": "32px" },
    "48": { "$type": "dimension", "$value": "48px" },
    "64": { "$type": "dimension", "$value": "64px" },
    "controlGap": { "$type": "dimension", "$value": "{space.8}" },
    "fieldGap": { "$type": "dimension", "$value": "{space.16}" },
    "section": { "$type": "dimension", "$value": "{space.48}" }
  },
  "size": {
    "control": { "$type": "dimension", "$value": "44px" },
    "pageGutter": { "$type": "dimension", "$value": "{space.24}" },
    "contentMax": { "$type": "dimension", "$value": "1200px" }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": "4px" },
    "container": { "$type": "dimension", "$value": "8px" }
  },
  "button": {
    "primary": {
      "background": { "$type": "color", "$value": "{color.text.primary}" },
      "label": { "$type": "color", "$value": "{color.surface}" }
    }
  }
}
